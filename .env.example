# =============================================================================
#  rigor - secrets template (safe to commit)
# =============================================================================
#  Copy this file to ".env" and fill in real values there.
#  ".env" is gitignored and must never be committed.
# =============================================================================

# EODHD API token. Required for live data (not for the demo or the test suite).
# Get it from: https://eodhd.com/  ->  Settings  ->  API key
EODHD_API_KEY=PASTE_YOUR_KEY_HERE

# FRED API key (free, optional). When set, FRED series come from the official API
# instead of the keyless public CSV endpoint, which is less reliable under load.
# Get one at: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=PASTE_YOUR_FRED_KEY_HERE
